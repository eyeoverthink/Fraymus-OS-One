{
  "name": "fraymus-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server and localhost JSON endpoint exposing the Fraymus OS One studio API as agent tools, with SHA-256 chained receipts.",
  "bin": {
    "fraymus-portal": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
