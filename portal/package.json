    "smoke": "node test/smoke.mjs",
    "verify-receipts": "node scripts/verify-receipts.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
